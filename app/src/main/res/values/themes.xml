<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ASMRHelper" parent="android:Theme.Material.NoActionBar" />

    <!-- 启动闪屏：黑底 + 居中图标，结束后切回 Theme.ASMRHelper -->
    <style name="Theme.ASMRHelper.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.ASMRHelper</item>
    </style>
</resources>
